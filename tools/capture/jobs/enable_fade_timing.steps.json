  },
  {
   "frames": 120
  },
  {
   "script": "player.MoveTo @term 0 -110 0"
  },
  {
   "frames": 60
  },
  {
   "remember": "player.GetAngle Z + player.GetHeadingAngle @term",
   "as": "face"
  },
  {
   "script": [
    "player.SetAngle Z %{face}",
    "player.SetAngle X 10"
   ]
  },
  {
   "console": "tm"
  },
  {
   "frames": 60
