      "probes": [
        {
          "id": "w6d7_35_add_npc_and_creature_to_leveled_list_edges",
          "bucket": "leveled_lists",
          "extender": "JIP LN NVSE",
          "required_plugins": [
            "jip_nvse.dll"
          ],
          "optional_extender": false,
          "requires_world": true,
          "mutates_state": true,
          "requires_fixture": null,
          "requires_isolated_staging": false,
          "spec_file": "docs/spec-notes/actor-list-additions.md",
          "spec_line": 28,
          "functions_tested": [
            "AddNPCToLeveledList",
            "AddCreatureToLeveledList",
            "GetNumLevItems",
            "GetNthLevItem",
            "GetNthLevItemLevel",
            "RemoveNthLevItem"
          ],
          "claim": "SD-14: Test AddNPCToLeveledList (LVLN 15F313) and AddCreatureToLeveledList (LVLC 156792) with boundary levels 0, 1, 65535, 70000, and -1 (NVForever rejects 0 and >65535).",
          "expected": "Record list counts and stored u16/i16 levels for each boundary level on both LVLN and LVLC.",
          "script_lines": [
            "ref rLvln = GetFormFromMod \"FalloutNV.esm\" \"15F313\"",
            "ref rLvlc = GetFormFromMod \"FalloutNV.esm\" \"156792\"",
            "ref rNpcA = GetFormFromMod \"FalloutNV.esm\" \"2E29D\"",
            "ref rCreA = GetFormFromMod \"FalloutNV.esm\" \"1CF7C\"",
            "int iN0 = GetNumLevItems rLvln",
            "AddNPCToLeveledList rLvln rNpcA 0",
            "int iN1 = GetNumLevItems rLvln",
            "AddNPCToLeveledList rLvln rNpcA 65535",
            "int iN2 = GetNumLevItems rLvln",
            "AddNPCToLeveledList rLvln rNpcA 70000",
            "int iN3 = GetNumLevItems rLvln",
            "AddNPCToLeveledList rLvln rNpcA -1",
            "int iN4 = GetNumLevItems rLvln",
            "int iNLv0 = -99",
            "int iNLv1 = -99",
            "int iNLv2 = -99",
            "int iNLv3 = -99",
            "if iN1 > iN0",
            "  let iNLv0 := GetNthLevItemLevel rLvln (iN1 - 1)",
            "endif",
            "if iN2 > iN1",
            "  let iNLv1 := GetNthLevItemLevel rLvln (iN2 - 1)",
            "endif",
            "if iN3 > iN2",
            "  let iNLv2 := GetNthLevItemLevel rLvln (iN3 - 1)",
            "endif",
            "if iN4 > iN3",
            "  let iNLv3 := GetNthLevItemLevel rLvln (iN4 - 1)",
            "endif",
            "int iSafeN = 0",
            "while ((GetNumLevItems rLvln) > iN0) && (iSafeN < 10)",
            "  int iLastN = (GetNumLevItems rLvln) - 1",
            "  RemoveNthLevItem rLvln iLastN",
            "  let iSafeN += 1",
            "loop",
            "int iC0 = GetNumLevItems rLvlc",
            "AddCreatureToLeveledList rLvlc rCreA 0",
            "int iC1 = GetNumLevItems rLvlc",
            "AddCreatureToLeveledList rLvlc rCreA 65535",
            "int iC2 = GetNumLevItems rLvlc",
            "AddCreatureToLeveledList rLvlc rCreA 70000",
            "int iC3 = GetNumLevItems rLvlc",
            "int iCLv0 = -99",
            "int iCLv1 = -99",
            "int iCLv2 = -99",
            "if iC1 > iC0",
            "  let iCLv0 := GetNthLevItemLevel rLvlc (iC1 - 1)",
            "endif",
            "if iC2 > iC1",
            "  let iCLv1 := GetNthLevItemLevel rLvlc (iC2 - 1)",
            "endif",
            "if iC3 > iC2",
            "  let iCLv2 := GetNthLevItemLevel rLvlc (iC3 - 1)",
            "endif",
            "int iSafeC = 0",
            "while ((GetNumLevItems rLvlc) > iC0) && (iSafeC < 10)",
            "  int iLastC = (GetNumLevItems rLvlc) - 1",
            "  RemoveNthLevItem rLvlc iLastC",
            "  let iSafeC += 1",
            "loop",
            "string_var sOut = sv_Construct \"PROBE|w6d7_35_add_npc_and_creature_to_leveled_list_edges|lvln(n=%g->%g/%g/%g/%g,lv=%g,%g,%g,%g)\" iN0 iN1 iN2 iN3 iN4 iNLv0 iNLv1 iNLv2 iNLv3",
            "let sOut += sv_Construct \"|lvlc(n=%g->%g/%g/%g,lv=%g,%g,%g)\" iC0 iC1 iC2 iC3 iCLv0 iCLv1 iCLv2",
            "PrintToConsole \"%z\" sOut"
          ]
        }
      ]
    }
