          "spec_line": 84,
          "functions_tested": [
            "GetExplosionTraitForm",
            "SetExplosionTraitForm",
            "GetLoadedTypeArray"
          ],
          "claim": "Reconcile SetExplosionTraitForm null-ref variable vs omitted 3rd argument across slots 0, 4, 5, and 6, and scan all 223 loaded EXPL forms for ESM-populated slot 4.",
          "expected": "Passing rNull=0 is ignored (unchanged) on every slot 0/4/5/6, whereas omitting the 3rd arg clears every slot 0/4/5/6 to 00000000 (reconciling w4d_27 vs gaps7).",
          "script_lines": [
            "array_var aExpls = GetLoadedTypeArray 81",
            "int nExpl = ar_Size aExpls",
            "int nPop4 = 0",
            "int i = 0",
            "while i < nExpl",
            "  ref rCand = aExpls[i]",
            "  if (GetExplosionTraitForm rCand 4) != 0",
            "    let nPop4 += 1",
            "  endif",
            "  let i += 1",
            "loop",
            "ref rE = GetFormFromMod \"FalloutNV.esm\" \"179DA\"",
            "ref rEuc = GetFormFromMod \"FalloutNV.esm\" \"172FBD\"",
            "ref rStat = GetFormFromMod \"FalloutNV.esm\" \"3B\"",
            "ref rNull = 0",
            "ref s4_0 = GetExplosionTraitForm rE 4",
            "SetExplosionTraitForm rE 4 rStat",
            "ref s4_set = GetExplosionTraitForm rE 4",
            "SetExplosionTraitForm rE 4 rNull",
            "ref s4_null = GetExplosionTraitForm rE 4",
            "ref fLit0 = CompileScript \"nvseprobe_h_w4h02_lit0_4.gek\"",
            "ref s4_lit0 = s4_null",
            "if fLit0",
            "  Call fLit0",
            "  let s4_lit0 := GetExplosionTraitForm rE 4",
            "endif",
            "SetExplosionTraitForm rE 4 rStat",
            "ref fOm4 = CompileScript \"nvseprobe_h_w4h02_omit4.gek\"",
            "ref s4_omit = rStat",
            "if fOm4",
            "  Call fOm4",
            "  let s4_omit := GetExplosionTraitForm rE 4",
            "endif",
            "ref s0_0 = GetExplosionTraitForm rE 0",
            "SetExplosionTraitForm rE 0 rNull",
            "ref s0_null = GetExplosionTraitForm rE 0",
            "SetExplosionTraitForm rE 0 s0_0",
            "ref fOm0 = CompileScript \"nvseprobe_h_w4h02_omit0.gek\"",
            "ref s0_omit = s0_0",
            "if fOm0",
            "  Call fOm0",
            "  let s0_omit := GetExplosionTraitForm rE 0",
            "endif",
            "SetExplosionTraitForm rE 0 s0_0",
            "ref s6_0 = GetExplosionTraitForm rE 6",
            "SetExplosionTraitForm rE 6 rNull",
            "ref s6_null = GetExplosionTraitForm rE 6",
            "SetExplosionTraitForm rE 6 s6_0",
            "ref fOm6 = CompileScript \"nvseprobe_h_w4h02_omit6.gek\"",
            "ref s6_omit = s6_0",
            "if fOm6",
            "  Call fOm6",
            "  let s6_omit := GetExplosionTraitForm rE 6",
            "endif",
            "SetExplosionTraitForm rE 6 s6_0",
            "ref s5_0 = GetExplosionTraitForm rEuc 5",
            "SetExplosionTraitForm rEuc 5 rNull",
            "ref s5_null = GetExplosionTraitForm rEuc 5",
            "SetExplosionTraitForm rEuc 5 s5_0",
            "ref fOm5 = CompileScript \"nvseprobe_h_w4h02_omit5.gek\"",
            "ref s5_omit = s5_0",
            "if fOm5",
            "  Call fOm5",
            "  let s5_omit := GetExplosionTraitForm rEuc 5",
            "endif",
            "SetExplosionTraitForm rEuc 5 s5_0",
            "int iLit0Ok = fLit0 != 0",
            "int iOm4Ok = fOm4 != 0",
            "string_var sA = sv_Construct \"esmPop4=%g/%g|s4(0=%i,set=%i,null=%i,lit0(%g)=%i,omit(%g)=%i)\" nPop4 nExpl s4_0 s4_set s4_null iLit0Ok s4_lit0 iOm4Ok s4_omit",
            "string_var sB = sv_Construct \"s0(0=%i,null=%i,omit=%i)|s5(0=%i,null=%i,omit=%i)|s6(0=%i,null=%i,omit=%i)\" s0_0 s0_null s0_omit s5_0 s5_null s5_omit s6_0 s6_null s6_omit",
            "PrintToConsole \"PROBE|w4h_02_explosion_slot4_reconcile|%z|%z\" sA sB"
          ],
          "helper_scripts": {
            "nvseprobe_h_w4h02_omit4.gek": [
              "ref rE = GetFormFromMod \"FalloutNV.esm\" \"179DA\"",
              "SetExplosionTraitForm rE 4"
            ],
            "nvseprobe_h_w4h02_lit0_4.gek": [
              "ref rE = GetFormFromMod \"FalloutNV.esm\" \"179DA\"",
              "SetExplosionTraitForm rE 4 0"
