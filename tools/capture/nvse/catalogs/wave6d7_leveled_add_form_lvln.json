      "id": "w6d7_leveled_add_form_lvln",
      "title": "Wave 6D-7: LeveledListAddForm accepts above-PC level on LVLN",
      "extender": "JIP LN NVSE",
      "required_plugins": [
        "jip_nvse.dll"
      ],
      "probes": [
        {
          "id": "w6d7_36_leveled_list_add_form_above_pc_level_and_order",
          "bucket": "leveled_lists",
          "extender": "JIP LN NVSE",
          "required_plugins": [
            "jip_nvse.dll"
          ],
          "optional_extender": false,
          "requires_world": true,
          "mutates_state": true,
          "requires_fixture": null,
          "requires_isolated_staging": false,
          "spec_file": "docs/spec-notes/actor-list-additions.md",
          "spec_line": 45,
          "functions_tested": [
            "LeveledListAddForm",
            "LeveledListRemoveForm",
            "GetNumLevItems",
            "GetNthLevItem",
            "GetNthLevItemLevel"
          ],
          "claim": "SD-14: Test JIP/LU LeveledListAddForm with level=50 (above PC level!), level=0, count=0/2 on LVLI (AA1) and LVLN (15F313) to verify whether NVForever's level > player_level rejection diverges.",
          "expected": "Record list growth, stored levels, and sorting order for level=50, level=0, and count=0 on LVLI and LVLN.",
          "script_lines": [
            "ref rLvli = GetFormFromMod \"FalloutNV.esm\" \"AA1\"",
            "ref rLvln = GetFormFromMod \"FalloutNV.esm\" \"15F313\"",
            "ref rItm = GetFormFromMod \"FalloutNV.esm\" \"15169\"",
            "ref rNpcA = GetFormFromMod \"FalloutNV.esm\" \"2E29D\"",
            "int iI0 = GetNumLevItems rLvli",
            "LeveledListAddForm rLvli rItm 50 2 1.0",
            "int iI1 = GetNumLevItems rLvli",
            "LeveledListAddForm rLvli rItm 0 1 1.0",
            "int iI2 = GetNumLevItems rLvli",
            "LeveledListAddForm rLvli rItm 1 0 1.0",
            "int iI3 = GetNumLevItems rLvli",
            "int iGot50 = 0",
            "int iIdx = 0",
            "while iIdx < iI3",
            "  if (GetNthLevItem rLvli iIdx) == rItm",
            "    if (GetNthLevItemLevel rLvli iIdx) == 50",
            "      let iGot50 := 1",
            "    endif",
            "  endif",
            "  let iIdx += 1",
            "loop",
            "LeveledListRemoveForm rLvli rItm",
            "int iN0 = GetNumLevItems rLvln",
            "LeveledListAddForm rLvln rNpcA 50 1 1.0",
            "int iN1 = GetNumLevItems rLvln",
            "LeveledListRemoveForm rLvln rNpcA",
            "string_var sOut = sv_Construct \"PROBE|w6d7_36_leveled_list_add_form_above_pc_level_and_order|lvli(n=%g->%g->%g->%g,got50=%g)|lvln(n=%g->%g)\" iI0 iI1 iI2 iI3 iGot50 iN0 iN1",
            "PrintToConsole \"%z\" sOut"
          ]
        }
      ]
    }
  ]
