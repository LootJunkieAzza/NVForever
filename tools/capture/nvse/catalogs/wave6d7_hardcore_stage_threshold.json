                "int iSpTrkOff = Player.IsSpellTarget rD2",
                "int iThr0 = Player.AuxVarGetFlt \"*w6d725_thr0\"",
                "int iThr1 = Player.AuxVarGetFlt \"*w6d725_thr1\"",
