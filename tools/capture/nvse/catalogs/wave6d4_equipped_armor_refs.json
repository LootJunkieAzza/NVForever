          "required_plugins": [
            "jip_nvse.dll"
          ],
          "optional_extender": false,
          "requires_world": true,
          "mutates_state": true,
          "requires_fixture": null,
          "requires_isolated_staging": false,
          "spec_file": "docs/spec-notes/ext-unlisted-rest.md",
          "spec_line": 308,
          "functions_tested": [
            "GetHitNode",
            "GetCollisionNodes",
            "GetEquippedArmorRefs",
            "TempCloneForm"
          ],
          "claim": "SD-07 & SD-08 (P0): Verify GetHitNode on NPC_ (DocMitchellREF / Player), GetCollisionNodes exact count and sample names on DocMitchellREF, and GetEquippedArmorRefs when wearing a TempCloneForm armor (checks unclone and FF inv-ref).",
          "expected": "NVForever ignores NPC_ in GetHitNode, returns empty array for GetCollisionNodes, and drops TempCloneForm equipped armor (without unclone) while returning base forms instead of FF inv-refs.",
          "script_lines": [
            "ref rDoc = GetFormFromMod \"FalloutNV.esm\" \"104C0F\"",
            "ref rArm = GetFormFromMod \"FalloutNV.esm\" \"20423\"",
            "string_var hnD = rDoc.GetHitNode",
            "string_var hnP = Player.GetHitNode",
            "array_var aCol = rDoc.GetCollisionNodes",
            "int cSz = ar_Size aCol",
            "string_var c0 = \"none\"",
            "if cSz > 0",
            "  let c0 := aCol[0]",
            "endif",
            "ref rArmC = TempCloneForm rArm 0",
            "Player.AddItem rArmC 1 1",
            "Player.EquipItem rArmC 0 1",
            "array_var aEq = Player.GetEquippedArmorRefs",
            "int eqSz = ar_Size aEq",
            "string_var eqId = \"none\"",
            "int eqIsClone = 0",
            "if eqSz > 0",
            "  let eqId := GetFormIDString (aEq[0])",
            "  let eqIsClone := ((aEq[0]) == rArmC)",
            "endif",
            "Player.UnequipItem rArmC 0 1",
            "Player.RemoveItem rArmC 1 1",
            "PrintToConsole \"PROBE|w6d4_18_hit_node_collision_nodes_cloned_armor|hn(d=[%z],p=[%z])|col(sz=%g,n0=[%z])|eqArm(sz=%g,id=%z,isBase=%g)\" hnD hnP cSz c0 eqSz eqId eqIsClone"
          ],
          "wait_ticks_after": 2,
          "extra_steps": []
        }
      ]
    }
