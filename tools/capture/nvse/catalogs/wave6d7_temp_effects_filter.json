      ],
      "probes": [
        {
          "id": "w6d7p2_18_temp_effects_and_ingestible_effects_fixed",
          "bucket": "aid_temp_effects",
          "extender": "JIP LN NVSE / JohnnyGuitarNVSE",
          "required_plugins": [
            "jip_nvse.dll",
            "johnnyguitar.dll"
          ],
          "optional_extender": false,
          "requires_world": true,
          "mutates_state": true,
          "requires_fixture": null,
          "requires_isolated_staging": false,
          "spec_file": "docs/spec-notes/aid-items.md",
          "spec_line": 250,
          "functions_tested": [
            "GetTempEffects",
            "GetTempIngestibleEffects",
            "RemoveNthTempEffect",
            "EquipItem",
            "SetHardcore",
            "Dispel"
          ],
          "claim": "SD-05: Compare JIP GetTempEffects vs JG GetTempIngestibleEffects on Buffout (USAGE_MONITOR 108000s check), non-Hardcore Stimpak, Hardcore Stimpak (Medicine 100 magnitude scaling), and RemoveNthTempEffect.",
          "expected": "Record exact counts, durations, magnitudes, and USAGE_MONITOR filtering in GetTempEffects and GetTempIngestibleEffects.",
          "script_lines": [
            "ref rBuf = GetFormFromMod \"FalloutNV.esm\" \"15163\"",
            "ref rStim = GetFormFromMod \"FalloutNV.esm\" \"15169\"",
            "int iHc0 = IsHardcore",
            "float fMed0 = Player.GetBaseAV Medicine",
            "SetHardcore 0",
            "Player.DispelAllSpells",
            "Player.AddItem rBuf 1 1",
            "Player.EquipItem rBuf 0 1",
            "array_var aJipB = Player.GetTempEffects",
            "array_var aJgB = Player.GetTempIngestibleEffects",
            "int iJipBn = ar_Size aJipB",
            "int iJgBn = ar_Size aJgB",
            "float fJipMaxD = -1",
            "float fJipMinD = 999999",
            "int iIdx = 0",
            "while iIdx < iJipBn",
            "  float fD = aJipB[iIdx][5]",
            "  if fD > fJipMaxD",
            "    let fJipMaxD := fD",
            "  endif",
            "  if fD < fJipMinD",
            "    let fJipMinD := fD",
            "  endif",
            "  let iIdx += 1",
            "loop",
            "float fJgBufL = -1",
            "float fJgBufD = -1",
            "let iIdx := 0",
            "while iIdx < iJgBn",
            "  ref rIt = aJgB[iIdx][0]",
            "  if rIt == rBuf",
            "    let fJgBufL := aJgB[iIdx][1]",
            "    let fJgBufD := aJgB[iIdx][2]",
            "  endif",
            "  let iIdx += 1",
            "loop",
            "Player.RemoveNthTempEffect 0",
            "array_var aJipRm = Player.GetTempEffects",
            "int iJipRmN = ar_Size aJipRm",
            "Player.Dispel rBuf",
            "Player.SetAV Medicine 100",
            "Player.DamageAV Health 20",
            "Player.AddItem rStim 1 1",
            "Player.EquipItem rStim 0 1",
            "array_var aJipS = Player.GetTempEffects",
            "array_var aJgS = Player.GetTempIngestibleEffects",
            "int iJipSn = ar_Size aJipS",
            "int iJgSn = ar_Size aJgS",
            "Player.Dispel rStim",
            "SetHardcore 1",
            "Player.AddItem rStim 1 1",
            "Player.EquipItem rStim 0 1",
            "array_var aJipHc = Player.GetTempEffects",
            "array_var aJgHc = Player.GetTempIngestibleEffects",
            "int iJipHcN = ar_Size aJipHc",
            "int iJgHcN = ar_Size aJgHc",
            "float fHcMag = -1",
            "float fHcDur = -1",
            "if iJipHcN > 0",
            "  let fHcMag := aJipHc[0][2]",
            "  let fHcDur := aJipHc[0][5]",
            "endif",
            "Player.Dispel rStim",
            "Player.SetAV Medicine fMed0",
            "SetHardcore iHc0",
            "Player.ResetHealth",
            "string_var sOut = sv_Construct \"PROBE|w6d7p2_18_temp_effects_and_ingestible_effects_fixed|buf(jipN=%g,minD=%.1f,maxD=%.1f,jgN=%g,jgL=%.1f,jgD=%.1f,rmN=%g)\" iJipBn fJipMinD fJipMaxD iJgBn fJgBufL fJgBufD iJipRmN",
            "let sOut += sv_Construct \"|nhStim(jipN=%g,jgN=%g)|hcStim(jipN=%g,jgN=%g,mag=%.1f,dur=%.1f)\" iJipSn iJgSn iJipHcN iJgHcN fHcMag fHcDur",
            "PrintToConsole \"%z\" sOut"
          ]
        }
      ]
    }
  ]
