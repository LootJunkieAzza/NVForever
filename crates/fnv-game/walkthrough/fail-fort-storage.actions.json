{
  "format": "fnv.script.actions/1",
  "plugins": ["FalloutNV.esm"],
  "title": "Headless fail path: the player robs the Fort's player storage (its OnOpen sets VMQ02 110), the Legion turns hostile, and the chip has to be taken back from Caesar",
  "given": [
    {"kind": "menu", "menu": 1001, "open": false},
    {"kind": "quest", "quest": "VMQTops", "running": true, "completed": true, "stage": 80, "done": [80]},
    {"kind": "global", "name": "VStoryEventBennyKilledCasino", "value": 1},
    {"kind": "global", "name": "VStoryState", "value": 20},
    {"kind": "item_count", "of": "player", "item": "VPlatinumChip", "count": 1}
  ],
  "actions": [
    {"op": "note", "text": "Starts as legion.actions.json does (Benny killed at the Tops, the chip carried). Vulpes on the Strip, Lucullus's barge, the Fort's arrival trigger and the gate guard's confiscation are that chain's steps; the chip goes to Caesar with the gear."},
    {"op": "move_player", "to": "scripted:VStreetEventStarterScript"},
    {"op": "advance_seconds", "seconds": 3},
    {"op": "talk", "actor": "VVulpesIncultaStripRef", "label": "Vulpes greets"},
    {"op": "wait_talk"},
    {"op": "choose", "topic": "VFreeformTheFortVVulpesIncultaStripTopic002", "label": "Vulpes: go to Cottonwood Cove"},
    {"op": "wait_talk"},
    {"op": "wait_quest", "quest": "VMQ02", "field": "done.1", "value": true, "max_frames": 1200, "label": "milestone: VMQ02 1 (sent to the Fort)"},
    {"op": "move_player", "to": "VCCLucullusREF"},
    {"op": "talk", "actor": "VCCLucullusREF", "label": "Lucullus greets"},
    {"op": "wait_talk"},
    {"op": "choose", "topic": "VFreeformCottonwoodCoveNVCCLucullusTopic000", "label": "Lucullus: ride to the Fort"},
    {"op": "wait_talk"},
    {"op": "advance_seconds", "seconds": 2},
    {"op": "trigger_enter", "trigger": "scripted:FortArrivalTriggerScript"},
    {"op": "wait_quest", "quest": "VMQ02", "field": "done.2", "value": true, "max_frames": 1200, "label": "milestone: VMQ02 2 (at the Fort)"},
    {"op": "talk", "actor": "FortLegionaryEntranceGreeterRef", "label": "gate guard greets"},
    {"op": "wait_talk"},
    {"op": "choose", "topic": "VFreeformCottonwoodCoveFortLegionaryEntranceGreeterTopic000", "label": "guard: hand over the gear"},
    {"op": "wait_talk"},
    {"op": "advance_seconds", "seconds": 2},
    {"op": "get_quest", "quest": "FortEquipmentConfiscationQuest", "fields": ["running", "var.bFortEquipmentStored"], "label": "milestone: gear confiscated"},
    {"op": "get_item_count", "of": "FortCaesarRef", "item": "VPlatinumChip", "label": "the chip on Caesar"},
    {"op": "note", "text": "The storage is locked with a key (lock level 255); the gate guard carries the key. The player lifts it from him (pickpocket stand-in: the key moved by hand) and opens the storage."},
    {"op": "call", "line": "FortLegionaryEntranceGreeterRef.RemoveItem WeaponsFootlockerKey 1"},
    {"op": "add_item", "to": "player", "item": "WeaponsFootlockerKey", "count": 1},
    {"op": "move_player", "to": "NVCCPlayerStorageREF"},
    {"op": "player_activate", "target": "NVCCPlayerStorageREF", "label": "storage opened"},
    {"op": "advance_seconds", "seconds": 2},
    {"op": "get_quest", "quest": "VMQ02", "fields": ["running", "failed", "stage", "done.110"], "label": "fail: VMQ02 110 (the Legion turns hostile)"},
    {"op": "get_quest", "quest": "VMQCaesarFail", "fields": ["running", "failed", "stage"], "label": "VMQCaesarFail after the robbery"},
    {"op": "get_item_count", "of": "FortCaesarRef", "item": "VPlatinumChip", "label": "the chip still on Caesar"},
    {"op": "get_quest", "quest": "VFreeformTheFort", "fields": ["running"], "label": "the Fort's freeform quest stopped"},
    {"op": "get_quest", "quest": "VMQYesManFailsafe", "fields": ["running", "stage", "done.1"], "label": "Wild Card failsafe running"},
    {"op": "note", "text": "The way on: the Platinum Chip is still on Caesar (VMQ02 110 takes it from him only when the player already has it). The player fights through to his tent and kills him (combat stand-in), then loots the chip."},
    {"op": "move_player", "to": "FortCaesarRef"},
    {"op": "kill", "actor": "FortCaesarRef", "killer": "player"},
    {"op": "advance_seconds", "seconds": 1},
    {"op": "remove_all_items", "from": "FortCaesarRef", "to": "player"},
    {"op": "advance_seconds", "seconds": 1},
    {"op": "get_item_count", "of": "player", "item": "VPlatinumChip", "label": "milestone: the chip taken back from Caesar"},
    {"op": "note", "text": "With the chip, Yes Man's line opens as in yesman.actions.json (Benny's suite floor at the Tops, travel stand-in): his plan starts VMQYesMan01 and VMQYesMan02."},
    {"op": "go_to_cell", "cell": "2ETopsBennysFloor"},
    {"op": "note", "text": "Leaving the Fort, FortEquipmentConfiscationQuest gives the rest of the gear back with a message box; the player closes it."},
    {"op": "dismiss_message_boxes", "max": 2, "wait_frames": 120, "label": "gear-returned box"},
    {"op": "talk", "actor": "VMQTopsYesManREF", "label": "yes man first greeting"},
    {"op": "choose", "topic": "YesManIntro", "label": "intro"},
    {"op": "choose", "topic": "VMQTopsVMQTopsYesManTopic000", "label": "intro 000"},
    {"op": "choose", "topic": "YesManChip", "label": "chip"},
    {"op": "choose", "topic": "YesManBenny", "label": "benny"},
    {"op": "choose", "topic": "VMQTopsVMQTopsYesManTopic003", "label": "003"},
    {"op": "choose", "topic": "VMQTopsVMQTopsYesManTopic008", "label": "008"},
    {"op": "choose", "topic": "VMQTopsVMQTopsYesManTopic009", "label": "009 the plan"},
    {"op": "wait_talk", "label": "after the plan"},
    {"op": "end_talk"},
    {"op": "advance_seconds", "seconds": 1},
    {"op": "get_quest", "quest": "VMQYesMan02", "fields": ["running", "objective.20.displayed"], "label": "milestone: VMQYesMan02 started"},
    {"op": "get_quest", "quest": "VMQYesMan01", "fields": ["running", "stage", "objective.50.displayed"], "label": "final: VMQYesMan01 started after the Legion's fail"}
  ]
}
