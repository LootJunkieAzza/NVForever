    {"op": "wait_frames", "frames": 2},
    {"op": "menu", "menu": null},
    {"op": "advance_seconds", "seconds": 8},
    {"op": "get_quest", "quest": "VCG00", "fields": ["running", "stage"], "label": "VCG00 after the opening"},
    {"op": "get_quest", "quest": "VCG01", "fields": ["running", "stage"], "label": "VCG01 at Doc's first line"},
    {"op": "note", "text": "Dialogue stand-ins: each say_info is the Doc Mitchell line whose end result script sets the next stage."},
