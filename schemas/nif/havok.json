        {"name": "process_contact_callback_delay", "type": "u16"}
      ]
    },
    "bhkRigidBodyCInfo550_660": {
      "note": "nif.xml <struct name=\"bhkRigidBodyCInfo550_660\"> (used for bs_version <= 34). rotation is an hkQuaternion stored x, y, z, w; inertia_tensor is a 3x3 matrix stored as three rows of four floats (fourth column unused).",
      "fields": [
        {"name": "unused_01", "type": "bytes", "length": 4},
        {"name": "havok_filter", "type": "HavokFilter"},
        {"name": "unused_02", "type": "bytes", "length": 4},
        {"name": "collision_response", "type": "hkResponseType"},
        {"name": "unused_03", "type": "u8"},
        {"name": "process_contact_callback_delay", "type": "u16"},
        {"name": "unused_04", "type": "bytes", "length": 4},
        {"name": "translation", "type": "vec4"},
        {"name": "rotation", "type": "vec4"},
        {"name": "linear_velocity", "type": "vec4"},
        {"name": "angular_velocity", "type": "vec4"},
        {"name": "inertia_tensor", "type": "mat34"},
        {"name": "center", "type": "vec4"},
        {"name": "mass", "type": "f32"},
