  "structs": {
    "HavokFilter": {
      "note": "nif.xml <struct name=\"HavokFilter\">: layer, filter flags and group packed into four bytes.",
      "fields": [
        {"name": "layer", "type": "OblivionLayer", "cond": "version <= 0x14000005 && bs_version < 16"},
        {"name": "layer", "type": "Fallout3Layer", "cond": "version == 0x14020007"},
        {"name": "flags", "type": "CollisionFilterFlags"},
        {"name": "group", "type": "u16"}
      ]
    },
    "HavokMaterial": {
      "note": "nif.xml <struct name=\"HavokMaterial\">: per-game material enum, always a u32 here.",
      "fields": [
        {"name": "material", "type": "OblivionHavokMaterial", "cond": "version <= 0x14000005 && bs_version < 16"},
        {"name": "material", "type": "Fallout3HavokMaterial", "cond": "version == 0x14020007"}
      ]
    },
    "hkSubPartData": {
      "note": "nif.xml <struct name=\"hkSubPartData\">.",
      "fields": [
        {"name": "havok_filter", "type": "HavokFilter"},
        {"name": "num_vertices", "type": "u32"},
        {"name": "material", "type": "HavokMaterial"}
      ]
    },
    "TriangleData": {
      "note": "nif.xml <struct name=\"TriangleData\">.",
      "fields": [
        {"name": "triangle", "type": "triangle"},
        {"name": "welding_info", "type": "bhkWeldInfo"},
        {"name": "normal", "type": "vec3", "until": "20.0.0.5"}
      ]
    },
    "bhkWorldObjCInfoProperty": {
      "note": "nif.xml <struct name=\"bhkWorldObjCInfoProperty\">.",
      "fields": [
        {"name": "data", "type": "u32"},
        {"name": "size", "type": "u32"},
        {"name": "capacity_and_flags", "type": "u32"}
      ]
    },
    "bhkWorldObjectCInfo": {
