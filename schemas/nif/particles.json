{
  "format": "fnv.nif.schema/1",
  "_comment": "Particle systems: NiParticleSystem and its data, modifiers, emitters, colliders and modifier controllers, plus the Bethesda particle blocks. Layouts re-expressed from niftools nif.xml (https://github.com/niftools/nifxml, read as documentation) for the versions in the FNV corpus only: 20.2.0.7 with user version 11 and bs_version 14-34, and 20.0.0.4 with user version 11. Fields that cannot occur in those versions are omitted. Every block is checked against the user's install with `fnvtool nif coverage` (exact consumption + byte-identical re-encode).",
  "enums": {
    "NiPSysModifierOrder": {
      "storage": "u32",
      "values": {"0": "ORDER_KILLOLDPARTICLES", "1": "ORDER_BSLOD", "1000": "ORDER_EMITTER", "2000": "ORDER_SPAWN", "2500": "ORDER_FO3_BSSTRIPUPDATE", "3000": "ORDER_GENERAL", "4000": "ORDER_FORCE", "5000": "ORDER_COLLIDER", "6000": "ORDER_POS_UPDATE", "6500": "ORDER_POSTPOS_UPDATE", "6600": "ORDER_WORLDSHIFT_PARTSPAWN", "7000": "ORDER_BOUND_UPDATE", "8000": "ORDER_SK_BSSTRIPUPDATE"}
    },
    "ForceType": {
      "storage": "u32",
      "values": {"0": "FORCE_PLANAR", "1": "FORCE_SPHERICAL", "2": "FORCE_UNKNOWN"}
    },
    "DecayType": {
      "storage": "u32",
      "values": {"0": "DECAY_NONE", "1": "DECAY_LINEAR", "2": "DECAY_EXPONENTIAL"}
    },
    "SymmetryType": {
      "storage": "u32",
      "values": {"0": "SPHERICAL_SYMMETRY", "1": "CYLINDRICAL_SYMMETRY", "2": "PLANAR_SYMMETRY"}
    },
    "VelocityType": {
      "storage": "u32",
      "values": {"0": "VELOCITY_USE_NORMALS", "1": "VELOCITY_USE_RANDOM", "2": "VELOCITY_USE_DIRECTION"}
    },
    "EmitFrom": {
      "storage": "u32",
      "values": {"0": "EMIT_FROM_VERTICES", "1": "EMIT_FROM_FACE_CENTER", "2": "EMIT_FROM_EDGE_CENTER", "3": "EMIT_FROM_FACE_SURFACE", "4": "EMIT_FROM_EDGE_SURFACE"}
    }
  },
  "structs": {
    "NiParticleInfo": {
      "fields": [
        {"name": "velocity", "type": "vec3"},
        {"name": "age", "type": "f32"},
        {"name": "life_span", "type": "f32"},
        {"name": "last_update", "type": "f32"},
        {"name": "spawn_generation", "type": "u16"},
        {"name": "code", "type": "u16"}
      ],
      "confidence": "documented",
      "note": "nif.xml <struct name=\"NiParticleInfo\">; its rotation axis exists only until 10.4.0.1."
    }
  },
  "blocks": {
    "NiParticlesData": {
      "inherit": "NiGeometryData",
      "fields": [
        {"name": "has_radii", "type": "bool"},
        {"name": "radii", "type": "f32", "length": "num_vertices", "cond": "has_radii && version != 0x14020007"},
        {"name": "num_active", "type": "u16"},
        {"name": "has_sizes", "type": "bool"},
        {"name": "sizes", "type": "f32", "length": "num_vertices", "cond": "has_sizes && version != 0x14020007"},
        {"name": "has_rotations", "type": "bool"},
        {"name": "rotations", "type": "quat", "length": "num_vertices", "cond": "has_rotations && version != 0x14020007"},
        {"name": "has_rotation_angles", "type": "bool"},
        {"name": "rotation_angles", "type": "f32", "length": "num_vertices", "cond": "has_rotation_angles && version != 0x14020007"},
        {"name": "has_rotation_axes", "type": "bool"},
        {"name": "rotation_axes", "type": "vec3", "length": "num_vertices", "cond": "has_rotation_axes && version != 0x14020007"},
        {"name": "has_texture_indices", "type": "bool", "cond": "version == 0x14020007"},
        {"name": "num_subtexture_offsets", "type": "u8", "cond": "version == 0x14020007"},
        {"name": "subtexture_offsets", "type": "vec4", "length": "num_subtexture_offsets", "cond": "version == 0x14020007"}
      ],
      "confidence": "documented",
      "note": "nif.xml <niobject name=\"NiParticlesData\">. Bethesda 20.2.0.7 files (every 20.2.0.7 file in the corpus has bs_version > 0) store only the presence flags, not the per-particle arrays."
    },
    "NiPSysData": {
      "inherit": "NiParticlesData",
      "fields": [
        {"name": "particle_info", "type": "NiParticleInfo", "length": "num_vertices", "cond": "version != 0x14020007"},
        {"name": "has_rotation_speeds", "type": "bool"},
        {"name": "rotation_speeds", "type": "f32", "length": "num_vertices", "cond": "has_rotation_speeds && version != 0x14020007"},
        {"name": "num_added_particles", "type": "u16", "cond": "version != 0x14020007"},
        {"name": "added_particles_base", "type": "u16", "cond": "version != 0x14020007"}
      ],
      "confidence": "documented",
      "note": "nif.xml <niobject name=\"NiPSysData\">."
    },
    "BSStripPSysData": {
      "inherit": "NiPSysData",
      "fields": [
        {"name": "max_point_count", "type": "u16"},
        {"name": "start_cap_size", "type": "f32"},
        {"name": "end_cap_size", "type": "f32"},
        {"name": "do_z_prepass", "type": "bool"}
      ],
      "confidence": "documented",
      "note": "nif.xml <niobject name=\"BSStripPSysData\">."
    },
    "NiParticleSystem": {
      "inherit": "NiParticles",
      "fields": [
        {"name": "world_space", "type": "bool"},
        {"name": "num_modifiers", "type": "u32"},
        {"name": "modifiers", "type": "ref", "length": "num_modifiers"}
      ],
      "confidence": "documented",
      "note": "nif.xml <niobject name=\"NiParticleSystem\">; its Skyrim/SSE/FO76 members do not occur at bs_version <= 34."
    },
    "BSStripParticleSystem": {"inherit": "NiParticleSystem", "confidence": "documented", "note": "nif.xml <niobject name=\"BSStripParticleSystem\">; no fields of its own."},
    "BSMasterParticleSystem": {
      "inherit": "NiNode",
      "fields": [
        {"name": "max_emitter_objects", "type": "u16"},
        {"name": "num_particle_systems", "type": "u32"},
        {"name": "particle_systems", "type": "ref", "length": "num_particle_systems"}
      ],
      "confidence": "documented",
      "note": "nif.xml <niobject name=\"BSMasterParticleSystem\">."
    },

