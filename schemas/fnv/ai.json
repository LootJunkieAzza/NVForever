        "name": "type",
        "type": {
         "enum": "u8",
         "values": {
          "0": "Find",
          "1": "Follow",
          "2": "Escort",
          "3": "Eat",
          "4": "Sleep",
          "5": "Wander",
          "6": "Travel",
          "7": "Accompany",
          "8": "Use Item At",
          "9": "Ambush",
