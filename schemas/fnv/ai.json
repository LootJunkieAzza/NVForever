          "13": "Always Run",
          "17": "Always Sneak",
          "18": "Allow Swimming",
          "19": "Allow Falls",
          "20": "Head-Tracking Off",
          "21": "Weapons Unequipped",
          "22": "Defensive Combat",
          "23": "Weapon Drawn",
          "24": "No Idle Anims",
          "25": "Pretend In Combat",
