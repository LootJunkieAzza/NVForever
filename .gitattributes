# tools/smoke/scenarios.toml: git's line merge, then checked (tools/smoke/merge_driver.py says how to
# turn the driver on; without it git merges as usual). Never merge=union: it keeps both
# sides of a conflict and drops the lines they share, fusing or doubling scenarios.
tools/smoke/scenarios.toml merge=smoke-scenarios

# NVIDIA's licence text, kept byte for byte (its SHA-256 is pinned by a test): no line-ending conversion.
engine/nvforever/src/dlss_download/nvngx_dlss.license.txt -text

# Published Rapier sources and licence retain their reviewed bytes on Windows too.
vendor/rapier3d/** -text

# Published winit sources retain their reviewed archive bytes on Windows too.
engine/vendor/winit/** -text
