{
 "scenarios": [
  {
   "id": "L5.ext.nvse.strings",
   "layer": 5,
   "description": "Extender string probes (tools/capture/ext-probes/strings): every EXTPROBE line the probe quests print, keyed by probe id. Oracle: the original game with xNVSE, collected by tools/capture/ext_probe_run.py from the owner's private test plugin NVFExtProbe.esp. Candidate: fnvtool ext probes, the same quests run headless (docs/spec-notes/ext-strings.md).",
   "oracle": {"golden": "ext/strings.json"},
   "candidate": {
    "argv": ["{candidate}", "ext", "probes", "{data_dir}", "FalloutNV.esm", "NVFExtProbe.esp", "--schema", "{schema_dir}",
             "--probes", "strings", "--probes-dir", "{lab_root}/../tools/capture/ext-probes"]
   },
   "comparator": {"kind": "keyed", "select": "/rows", "key": "id", "fields": ["value"]},
   "tags": ["ext", "nvse", "probes", "strings"]
  },
  {
