{
 "scenarios": [
  {
   "id": "L1.esm.inventory_xedit.FalloutNV",
   "layer": 1,
   "description": "Record inventory of FalloutNV.esm against an FNVEdit (xEdit) export: type, EditorID, FULL name.",
   "oracle": {
    "golden": "esm/FalloutNV.xedit.inventory.json"
   },
   "candidate": {
    "argv": [
     "{candidate}",
     "esm",
     "inventory",
     "{data_dir}/FalloutNV.esm"
    ]
   },
   "comparator": {
    "kind": "keyed",
    "select": "/records",
    "key": "formid",
    "fields": [
     "type",
     "edid",
     "full"
    ]
   },
   "tags": [
    "esm",
    "inventory",
    "xedit",
    "M1",
    "needs-local-capture"
   ]
